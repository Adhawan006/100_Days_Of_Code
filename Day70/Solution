class Solution {
    public int[] twoSum(int[] numbers, int target) {
        int s = 0;
        int e = numbers.length - 1;

        while(s <= e){
            if(numbers[s] + numbers[e] == t){
                return new int[] {s, e};
            }
            else if(numbers[s] + numbers[e] < t){
                s++;
            }
            else{
                e--;
            }
        }
        return new int[] {-1, -1};
    }
}